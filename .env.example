# Public URL of the corresponding source for the exact deployed ReLink release.
# Streamlit does not load this file automatically; export this variable in the
# launch environment. Do not enter credentials or an inaccessible private URL.
RELINK_SOURCE_URL=

# Private signed-in history is the default. Missing/expired identity cannot save
# or read disk history. "local" explicitly opts into a shared single-operator file;
# never use local mode for public/shared hosting.
RELINK_HISTORY_MODE=oidc
RELINK_HISTORY_ENABLED=1
# Private files: .relink/history-users/<opaque account namespace>.json
# Trusted base override; local mode uses this exact file, OIDC uses a sibling
# <base-stem>-users directory. Old shared records are not automatically migrated.
RELINK_HISTORY_PATH=

# Core paper/PDF dataset identification. Alternatively set these top-level values
# in the git-ignored .streamlit/secrets.toml. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
